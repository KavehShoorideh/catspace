/-- GDL `init.control`. -/
inductive initControl : Chess.Color → Prop where
  /-- `(init (control white))` -/
  | c1 : initControl Chess.Color.white

/-- GDL `init.halfmove`. -/
inductive initHalfmove : Nat → Prop where
  /-- `(init (halfmove 0))` -/
  | c1 : initHalfmove 0

/-- GDL `landed`. -/
inductive landed (p : Chess.Position) (mv : Ideas.Spec.Binding.MoveTerm) : Fin 8 → Fin 8 → Prop where
  /-- `(<= (landed ?f2 ?r2) (does ?c (move ?f1 ?r1 ?f2 ?r2)))` -/
  | c1 {f2 : Fin 8} {r2 : Fin 8} {c : Chess.Color} {f1 : Fin 8} {r1 : Fin 8} : Ideas.Spec.Binding.Does p mv c (Ideas.Spec.Binding.MoveTerm.move (f1, r1) (f2, r2)) → landed p mv f2 r2
  /-- `(<= (landed ?f2 ?r2) (does ?c (promote ?f1 ?r1 ?f2 ?r2 ?k)))` -/
  | c2 {f2 : Fin 8} {r2 : Fin 8} {c : Chess.Color} {f1 : Fin 8} {r1 : Fin 8} {k : Chess.PieceKind} : Ideas.Spec.Binding.Does p mv c (Ideas.Spec.Binding.MoveTerm.promote (f1, r1) (f2, r2) k) → landed p mv f2 r2
  /-- `(<= (landed ?rt ?r) (castled ?c ?side) (home_rank ?c ?r) (castling_path ?side ?kt ?rt ?rf))` -/
  | c3 {rt : Fin 8} {r : Fin 8} {c : Chess.Color} {side : Ideas.Spec.Binding.Wing} {kt : Fin 8} {rf : Fin 8} : castled p mv c side → homeRank c r → castlingPath side kt rt rf → landed p mv rt r

/-- GDL `lifted`. -/
inductive lifted (p : Chess.Position) (mv : Ideas.Spec.Binding.MoveTerm) : Fin 8 → Fin 8 → Prop where
  /-- `(<= (lifted ?f1 ?r1) (does ?c (move ?f1 ?r1 ?f2 ?r2)))` -/
  | c1 {f1 : Fin 8} {r1 : Fin 8} {c : Chess.Color} {f2 : Fin 8} {r2 : Fin 8} : Ideas.Spec.Binding.Does p mv c (Ideas.Spec.Binding.MoveTerm.move (f1, r1) (f2, r2)) → lifted p mv f1 r1
  /-- `(<= (lifted ?f1 ?r1) (does ?c (promote ?f1 ?r1 ?f2 ?r2 ?k)))` -/
  | c2 {f1 : Fin 8} {r1 : Fin 8} {c : Chess.Color} {f2 : Fin 8} {r2 : Fin 8} {k : Chess.PieceKind} : Ideas.Spec.Binding.Does p mv c (Ideas.Spec.Binding.MoveTerm.promote (f1, r1) (f2, r2) k) → lifted p mv f1 r1
  /-- `(<= (lifted ?rf ?r) (castled ?c ?side) (home_rank ?c ?r) (castling_path ?side ?kt ?rt ?rf))` -/
  | c3 {rf : Fin 8} {r : Fin 8} {c : Chess.Color} {side : Ideas.Spec.Binding.Wing} {kt : Fin 8} {rt : Fin 8} : castled p mv c side → homeRank c r → castlingPath side kt rt rf → lifted p mv rf r
  /-- `(<= (lifted ?f ?r) (passant_taken ?f ?r))` -/
  | c4 {f : Fin 8} {r : Fin 8} : passantTaken p mv f r → lifted p mv f r

/-- GDL `right_square`. -/
inductive rightSquare : Chess.Color → Ideas.Spec.Binding.Wing → Fin 8 → Fin 8 → Prop where
  /-- `(right_square white kingside e 1)` -/
  | c1 : rightSquare Chess.Color.white Ideas.Spec.Binding.Wing.kingside 4 0
  /-- `(right_square white kingside h 1)` -/
  | c2 : rightSquare Chess.Color.white Ideas.Spec.Binding.Wing.kingside 7 0
  /-- `(right_square white queenside e 1)` -/
  | c3 : rightSquare Chess.Color.white Ideas.Spec.Binding.Wing.queenside 4 0
  /-- `(right_square white queenside a 1)` -/
  | c4 : rightSquare Chess.Color.white Ideas.Spec.Binding.Wing.queenside 0 0
  /-- `(right_square black kingside e 8)` -/
  | c5 : rightSquare Chess.Color.black Ideas.Spec.Binding.Wing.kingside 4 7
  /-- `(right_square black kingside h 8)` -/
  | c6 : rightSquare Chess.Color.black Ideas.Spec.Binding.Wing.kingside 7 7
  /-- `(right_square black queenside e 8)` -/
  | c7 : rightSquare Chess.Color.black Ideas.Spec.Binding.Wing.queenside 4 7
  /-- `(right_square black queenside a 8)` -/
  | c8 : rightSquare Chess.Color.black Ideas.Spec.Binding.Wing.queenside 0 7

/-- GDL `touched`. -/
inductive touched (p : Chess.Position) (mv : Ideas.Spec.Binding.MoveTerm) : Fin 8 → Fin 8 → Prop where
  /-- `(<= (touched ?f ?r) (lifted ?f ?r))` -/
  | c1 {f : Fin 8} {r : Fin 8} : lifted p mv f r → touched p mv f r
  /-- `(<= (touched ?f ?r) (landed ?f ?r))` -/
  | c2 {f : Fin 8} {r : Fin 8} : landed p mv f r → touched p mv f r

/-- GDL `right_lost`. -/
inductive rightLost (p : Chess.Position) (mv : Ideas.Spec.Binding.MoveTerm) : Chess.Color → Ideas.Spec.Binding.Wing → Prop where
  /-- `(<= (right_lost ?c ?side) (right_square ?c ?side ?f ?r) (touched ?f ?r))` -/
  | c1 {c : Chess.Color} {side : Ideas.Spec.Binding.Wing} {f : Fin 8} {r : Fin 8} : rightSquare c side f r → touched p mv f r → rightLost p mv c side

/-- GDL `next.castling_right`. -/
inductive nextCastlingRight (p : Chess.Position) (mv : Ideas.Spec.Binding.MoveTerm) : Chess.Color → Ideas.Spec.Binding.Wing → Prop where
  /-- `(<= (next (castling_right ?c ?side)) (true (castling_right ?c ?side)) (not (right_lost ?c ?side)))` -/
  | c1 {c : Chess.Color} {side : Ideas.Spec.Binding.Wing} : Ideas.Spec.Binding.right c side ∈ p.castling → ¬ (rightLost p mv c side) → nextCastlingRight p mv c side

/-- GDL `next.cell`. -/
inductive nextCell (p : Chess.Position) (mv : Ideas.Spec.Binding.MoveTerm) : Fin 8 → Fin 8 → Chess.Color → Chess.PieceKind → Prop where
  /-- `(<= (next (cell ?f2 ?r2 ?c ?k)) (does ?c (move ?f1 ?r1 ?f2 ?r2)) (true (cell ?f1 ?r1 ?c ?k)))` -/
  | c1 {f2 : Fin 8} {r2 : Fin 8} {c : Chess.Color} {k : Chess.PieceKind} {f1 : Fin 8} {r1 : Fin 8} : Ideas.Spec.Binding.Does p mv c (Ideas.Spec.Binding.MoveTerm.move (f1, r1) (f2, r2)) → p.board (f1, r1) = some ⟨c, k⟩ → nextCell p mv f2 r2 c k
  /-- `(<= (next (cell ?f2 ?r2 ?c ?k)) (does ?c (promote ?f1 ?r1 ?f2 ?r2 ?k)))` -/
  | c2 {f2 : Fin 8} {r2 : Fin 8} {c : Chess.Color} {k : Chess.PieceKind} {f1 : Fin 8} {r1 : Fin 8} : Ideas.Spec.Binding.Does p mv c (Ideas.Spec.Binding.MoveTerm.promote (f1, r1) (f2, r2) k) → nextCell p mv f2 r2 c k
  /-- `(<= (next (cell ?rt ?r ?c rook)) (castled ?c ?side) (home_rank ?c ?r) (castling_path ?side ?kt ?rt ?rf))` -/
  | c3 {rt : Fin 8} {r : Fin 8} {c : Chess.Color} {side : Ideas.Spec.Binding.Wing} {kt : Fin 8} {rf : Fin 8} : castled p mv c side → homeRank c r → castlingPath side kt rt rf → nextCell p mv rt r c Chess.PieceKind.rook
  /-- `(<= (next (cell ?f ?r ?c ?k)) (true (cell ?f ?r ?c ?k)) (not (lifted ?f ?r)) (not (landed ?f ?r)))` -/
  | c4 {f : Fin 8} {r : Fin 8} {c : Chess.Color} {k : Chess.PieceKind} : p.board (f, r) = some ⟨c, k⟩ → ¬ (lifted p mv f r) → ¬ (landed p mv f r) → nextCell p mv f r c k

/-- GDL `next.control`. -/
inductive nextControl (p : Chess.Position) : Chess.Color → Prop where
  /-- `(<= (next (control ?o)) (true (control ?c)) (opponent ?c ?o))` -/
  | c1 {o : Chess.Color} {c : Chess.Color} : p.turn = c → opponent c o → nextControl p o

/-- GDL `next.ep_square`. -/
inductive nextEpSquare (p : Chess.Position) (mv : Ideas.Spec.Binding.MoveTerm) : Fin 8 → Fin 8 → Prop where
  /-- `(<= (next (ep_square ?f ?r2)) (does ?c (move ?f ?r1 ?f ?r3)) (true (cell ?f ?r1 ?c pawn)) (pawn_start ?c ?r1) (forward ?c ?d) (step ?d ?f ?r1 ?f ?r2) (step ?d ?f ?r2 ?f ?r3))` -/
  | c1 {f : Fin 8} {r2 : Fin 8} {c : Chess.Color} {r1 : Fin 8} {r3 : Fin 8} {d : Dir} : Ideas.Spec.Binding.Does p mv c (Ideas.Spec.Binding.MoveTerm.move (f, r1) (f, r3)) → p.board (f, r1) = some ⟨c, Chess.PieceKind.pawn⟩ → pawnStart c r1 → forward c d → step d f r1 f r2 → step d f r2 f r3 → nextEpSquare p mv f r2

/-- GDL `next.halfmove`. -/
inductive nextHalfmove (p : Chess.Position) (mv : Ideas.Spec.Binding.MoveTerm) : Nat → Prop where
  /-- `(<= (next (halfmove 0)) clock_reset)` -/
  | c1 : clockReset p mv → nextHalfmove p mv 0
  /-- `(<= (next (halfmove ?m)) (true (halfmove ?n)) (count_succ ?n ?m) (not clock_reset))` -/
  | c2 {m : Nat} {n : Nat} : Ideas.Spec.Binding.clock p = n → countSucc n m → ¬ (clockReset p mv) → nextHalfmove p mv m
  /-- `(<= (next (halfmove ?n)) (clock_limit ?n) (true (halfmove ?n)) (not clock_reset))` -/
  | c3 {n : Nat} : clockLimit n → Ideas.Spec.Binding.clock p = n → ¬ (clockReset p mv) → nextHalfmove p mv n

/-- GDL `terminal`. -/
inductive terminal (p : Chess.Position) (rec : Ideas.Game.Record Chess.Position Chess.RepetitionKey) : Prop where
  /-- `(<= terminal mate)` -/
  | c1 : mate p → terminal p rec
  /-- `(<= terminal stalemate)` -/
  | c2 : stalemate p → terminal p rec
  /-- `(<= terminal draw)` -/
  | c3 : draw p → terminal p rec
  /-- `(<= terminal draw_by_fifty_moves)` -/
  | c4 : drawByFiftyMoves p → terminal p rec
  /-- `(<= terminal draw_by_repetition)` -/
  | c5 : drawByRepetition p rec → terminal p rec

/-- THE SPEC'S NEXT STATE (76.1 (b) (4), generated from the fluent table): `q` is a position the `next` facts after the joint move `mv` describe --
every fluent's next relation holds of exactly what the fluent's binding reads off `q`. Its functionality and its equality with the kernel's
`Chess.applyMove` are proved in `Ideas.Spec.NextEquiv`. -/
def applyMoveSpec (p : Chess.Position) (mv : Ideas.Spec.Binding.MoveTerm) (q : Chess.Position) : Prop :=
  (∀ (x0 : Fin 8) (x1 : Fin 8) (x2 : Chess.Color) (x3 : Chess.PieceKind), nextCell p mv x0 x1 x2 x3 ↔ q.board (x0, x1) = some ⟨x2, x3⟩) ∧
  (∀ (x0 : Chess.Color), nextControl p x0 ↔ q.turn = x0) ∧
  (∀ (x0 : Chess.Color) (x1 : Ideas.Spec.Binding.Wing), nextCastlingRight p mv x0 x1 ↔ Ideas.Spec.Binding.right x0 x1 ∈ q.castling) ∧
  (∀ (x0 : Fin 8) (x1 : Fin 8), nextEpSquare p mv x0 x1 ↔ q.enPassant = some (x0, x1)) ∧
  (∀ (x0 : Nat), nextHalfmove p mv x0 ↔ Ideas.Spec.Binding.clock q = x0)

end Ideas.Spec.Chess
