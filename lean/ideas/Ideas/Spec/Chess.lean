  | c9 : initCell 0 1 Chess.Color.white Chess.PieceKind.pawn
  /-- `(init (cell b 2 white pawn))` -/
  | c10 : initCell 1 1 Chess.Color.white Chess.PieceKind.pawn
  /-- `(init (cell c 2 white pawn))` -/
  | c11 : initCell 2 1 Chess.Color.white Chess.PieceKind.pawn
