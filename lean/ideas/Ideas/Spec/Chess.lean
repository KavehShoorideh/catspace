/-- GDL `mating_material`. -/
inductive matingMaterial (p : Chess.Position) : Chess.Color → Prop where
  /-- `(<= (mating_material ?c) (true (cell ?f ?r ?c pawn)))` -/
  | c1 {c : Chess.Color} {f : Fin 8} {r : Fin 8} : p.board (f, r) = some ⟨c, Chess.PieceKind.pawn⟩ → matingMaterial p c
  /-- `(<= (mating_material ?c) (true (cell ?f ?r ?c rook)))` -/
  | c2 {c : Chess.Color} {f : Fin 8} {r : Fin 8} : p.board (f, r) = some ⟨c, Chess.PieceKind.rook⟩ → matingMaterial p c
  /-- `(<= (mating_material ?c) (true (cell ?f ?r ?c queen)))` -/
  | c3 {c : Chess.Color} {f : Fin 8} {r : Fin 8} : p.board (f, r) = some ⟨c, Chess.PieceKind.queen⟩ → matingMaterial p c

/-- GDL `has_kind`. -/
inductive hasKind (p : Chess.Position) : Chess.Color → Chess.PieceKind → Prop where
  /-- `(<= (has_kind ?c ?k) (true (cell ?f ?r ?c ?k)))` -/
  | c1 {c : Chess.Color} {k : Chess.PieceKind} {f : Fin 8} {r : Fin 8} : p.board (f, r) = some ⟨c, k⟩ → hasKind p c k

/-- GDL `two_units`. -/
inductive twoUnits (p : Chess.Position) : Chess.Color → Prop where
  /-- `(<= (two_units ?c) (true (cell ?f1 ?r1 ?c ?k1)) (distinct ?k1 king) (true (cell ?f2 ?r2 ?c ?k2)) (distinct ?k2 king) (distinct ?f1 ?f2))` -/
  | c1 {c : Chess.Color} {f1 : Fin 8} {r1 : Fin 8} {k1 : Chess.PieceKind} {f2 : Fin 8} {r2 : Fin 8} {k2 : Chess.PieceKind} : p.board (f1, r1) = some ⟨c, k1⟩ → k1 ≠ Chess.PieceKind.king → p.board (f2, r2) = some ⟨c, k2⟩ → k2 ≠ Chess.PieceKind.king → f1 ≠ f2 → twoUnits p c
  /-- `(<= (two_units ?c) (true (cell ?f1 ?r1 ?c ?k1)) (distinct ?k1 king) (true (cell ?f2 ?r2 ?c ?k2)) (distinct ?k2 king) (distinct ?r1 ?r2))` -/
  | c2 {c : Chess.Color} {f1 : Fin 8} {r1 : Fin 8} {k1 : Chess.PieceKind} {f2 : Fin 8} {r2 : Fin 8} {k2 : Chess.PieceKind} : p.board (f1, r1) = some ⟨c, k1⟩ → k1 ≠ Chess.PieceKind.king → p.board (f2, r2) = some ⟨c, k2⟩ → k2 ≠ Chess.PieceKind.king → r1 ≠ r2 → twoUnits p c

/-- GDL `selfmate_material`. -/
