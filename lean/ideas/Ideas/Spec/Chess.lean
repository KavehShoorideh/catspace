/-- GDL `init.cell`. -/
inductive initCell : Fin 8 → Fin 8 → Chess.Color → Chess.PieceKind → Prop where
  /-- `(init (cell a 1 white rook))` -/
  | c1 : initCell 0 0 Chess.Color.white Chess.PieceKind.rook
  /-- `(init (cell b 1 white knight))` -/
  | c2 : initCell 1 0 Chess.Color.white Chess.PieceKind.knight
