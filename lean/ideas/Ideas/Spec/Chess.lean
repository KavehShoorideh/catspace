/-- GDL `promotes`. -/
inductive promotes (p : Chess.Position) : Chess.Color → Fin 8 → Fin 8 → Fin 8 → Fin 8 → Prop where
  /-- `(<= (promotes ?c ?f1 ?r1 ?f2 ?r2) (candidate ?c ?f1 ?r1 ?f2 ?r2) (true (cell ?f1 ?r1 ?c pawn)) (last_rank ?c ?r2))` -/
  | c1 {c : Chess.Color} {f1 : Fin 8} {r1 : Fin 8} {f2 : Fin 8} {r2 : Fin 8} : candidate p c f1 r1 f2 r2 → p.board (f1, r1) = some ⟨c, Chess.PieceKind.pawn⟩ → lastRank c r2 → promotes p c f1 r1 f2 r2

/-- GDL `king_after`. -/
inductive kingAfter (p : Chess.Position) : Chess.Color → Fin 8 → Fin 8 → Fin 8 → Fin 8 → Fin 8 → Fin 8 → Prop where
  /-- `(<= (king_after ?c ?f1 ?r1 ?f2 ?r2 ?f ?r) (candidate ?c ?f1 ?r1 ?f2 ?r2) (after ?f1 ?r1 ?f2 ?r2 ?f ?r ?c king))` -/
  | c1 {c : Chess.Color} {f1 : Fin 8} {r1 : Fin 8} {f2 : Fin 8} {r2 : Fin 8} {f : Fin 8} {r : Fin 8} : candidate p c f1 r1 f2 r2 → after p f1 r1 f2 r2 f r c Chess.PieceKind.king → kingAfter p c f1 r1 f2 r2 f r

/-- GDL `king_ray`. -/
inductive kingRay (p : Chess.Position) (f1 : Fin 8) (r1 : Fin 8) (f2 : Fin 8) (r2 : Fin 8) (d : Dir) : Fin 8 → Fin 8 → Prop where
  /-- `(<= (king_ray ?f1 ?r1 ?f2 ?r2 ?d ?f ?r) (king_after ?c ?f1 ?r1 ?f2 ?r2 ?kf ?kr) (step ?d ?kf ?kr ?f ?r))` -/
  | c1 {f : Fin 8} {r : Fin 8} {c : Chess.Color} {kf : Fin 8} {kr : Fin 8} : kingAfter p c f1 r1 f2 r2 kf kr → step d kf kr f r → kingRay p f1 r1 f2 r2 d f r
  /-- `(<= (king_ray ?f1 ?r1 ?f2 ?r2 ?d ?f3 ?r3) (king_ray ?f1 ?r1 ?f2 ?r2 ?d ?f ?r) (not (after_occupied ?f1 ?r1 ?f2 ?r2 ?f ?r)) (step ?d ?f ?r ?f3 ?r3))` -/
  | c2 {f3 : Fin 8} {r3 : Fin 8} {f : Fin 8} {r : Fin 8} : kingRay p f1 r1 f2 r2 d f r → ¬ (afterOccupied p f1 r1 f2 r2 f r) → step d f r f3 r3 → kingRay p f1 r1 f2 r2 d f3 r3

/-- GDL `exposed`. -/
inductive exposed (p : Chess.Position) : Fin 8 → Fin 8 → Fin 8 → Fin 8 → Prop where
  /-- `(<= (exposed ?f1 ?r1 ?f2 ?r2) (king_after ?c ?f1 ?r1 ?f2 ?r2 ?kf ?kr) (king_ray ?f1 ?r1 ?f2 ?r2 ?d ?f ?r) (after ?f1 ?r1 ?f2 ?r2 ?f ?r ?o ?k) (opponent ?c ?o) (line_of ?k ?d))` -/
  | c1 {f1 : Fin 8} {r1 : Fin 8} {f2 : Fin 8} {r2 : Fin 8} {c : Chess.Color} {kf : Fin 8} {kr : Fin 8} {d : Dir} {f : Fin 8} {r : Fin 8} {o : Chess.Color} {k : Chess.PieceKind} : kingAfter p c f1 r1 f2 r2 kf kr → kingRay p f1 r1 f2 r2 d f r → after p f1 r1 f2 r2 f r o k → opponent c o → lineOf k d → exposed p f1 r1 f2 r2
  /-- `(<= (exposed ?f1 ?r1 ?f2 ?r2) (king_after ?c ?f1 ?r1 ?f2 ?r2 ?kf ?kr) (knight_jump ?kf ?kr ?f ?r) (after ?f1 ?r1 ?f2 ?r2 ?f ?r ?o knight) (opponent ?c ?o))` -/
  | c2 {f1 : Fin 8} {r1 : Fin 8} {f2 : Fin 8} {r2 : Fin 8} {c : Chess.Color} {kf : Fin 8} {kr : Fin 8} {f : Fin 8} {r : Fin 8} {o : Chess.Color} : kingAfter p c f1 r1 f2 r2 kf kr → knightJump kf kr f r → after p f1 r1 f2 r2 f r o Chess.PieceKind.knight → opponent c o → exposed p f1 r1 f2 r2
  /-- `(<= (exposed ?f1 ?r1 ?f2 ?r2) (king_after ?c ?f1 ?r1 ?f2 ?r2 ?kf ?kr) (king_step ?kf ?kr ?f ?r) (after ?f1 ?r1 ?f2 ?r2 ?f ?r ?o king) (opponent ?c ?o))` -/
  | c3 {f1 : Fin 8} {r1 : Fin 8} {f2 : Fin 8} {r2 : Fin 8} {c : Chess.Color} {kf : Fin 8} {kr : Fin 8} {f : Fin 8} {r : Fin 8} {o : Chess.Color} : kingAfter p c f1 r1 f2 r2 kf kr → kingStep kf kr f r → after p f1 r1 f2 r2 f r o Chess.PieceKind.king → opponent c o → exposed p f1 r1 f2 r2
  /-- `(<= (exposed ?f1 ?r1 ?f2 ?r2) (king_after ?c ?f1 ?r1 ?f2 ?r2 ?kf ?kr) (opponent ?c ?o) (pawn_diagonal ?o ?d) (step ?d ?f ?r ?kf ?kr) (after ?f1 ?r1 ?f2 ?r2 ?f ?r ?o pawn))` -/
  | c4 {f1 : Fin 8} {r1 : Fin 8} {f2 : Fin 8} {r2 : Fin 8} {c : Chess.Color} {kf : Fin 8} {kr : Fin 8} {o : Chess.Color} {d : Dir} {f : Fin 8} {r : Fin 8} : kingAfter p c f1 r1 f2 r2 kf kr → opponent c o → pawnDiagonal o d → step d f r kf kr → after p f1 r1 f2 r2 f r o Chess.PieceKind.pawn → exposed p f1 r1 f2 r2

