/-- GDL `legal`. -/
inductive legal (p : Chess.Position) : Chess.Color → Ideas.Spec.Binding.MoveTerm → Prop where
  /-- `(<= (legal ?c (move ?f1 ?r1 ?f2 ?r2)) (candidate ?c ?f1 ?r1 ?f2 ?r2) (not (promotes ?c ?f1 ?r1 ?f2 ?r2)) (not (exposed ?f1 ?r1 ?f2 ?r2)))` -/
  | c1 {c : Chess.Color} {f1 : Fin 8} {r1 : Fin 8} {f2 : Fin 8} {r2 : Fin 8} : candidate p c f1 r1 f2 r2 → ¬ (promotes p c f1 r1 f2 r2) → ¬ (exposed p f1 r1 f2 r2) → legal p c (Ideas.Spec.Binding.MoveTerm.move (f1, r1) (f2, r2))
  /-- `(<= (legal ?c (promote ?f1 ?r1 ?f2 ?r2 ?k)) (promotes ?c ?f1 ?r1 ?f2 ?r2) (not (exposed ?f1 ?r1 ?f2 ?r2)) (promotable ?k))` -/
  | c2 {c : Chess.Color} {f1 : Fin 8} {r1 : Fin 8} {f2 : Fin 8} {r2 : Fin 8} {k : Chess.PieceKind} : promotes p c f1 r1 f2 r2 → ¬ (exposed p f1 r1 f2 r2) → promotable k → legal p c (Ideas.Spec.Binding.MoveTerm.promote (f1, r1) (f2, r2) k)
  /-- `(<= (legal ?o noop) (true (control ?c)) (opponent ?c ?o))` -/
  | c3 {o : Chess.Color} {c : Chess.Color} : p.turn = c → opponent c o → legal p o Ideas.Spec.Binding.MoveTerm.noop

/-- GDL `has_move`. -/
inductive hasMove (p : Chess.Position) : Prop where
  /-- `(<= has_move (true (control ?c)) (legal ?c ?m))` -/
  | c1 {c : Chess.Color} {m : Ideas.Spec.Binding.MoveTerm} : p.turn = c → legal p c m → hasMove p

/-- GDL `draw_by_fifty_moves`. -/
inductive drawByFiftyMoves (p : Chess.Position) : Prop where
  /-- `(<= draw_by_fifty_moves (clock_limit ?n) (true (halfmove ?n)) has_move)` -/
  | c1 {n : Nat} : clockLimit n → Ideas.Spec.Binding.clock p = n → hasMove p → drawByFiftyMoves p

/-- GDL `repetition_limit`. -/
inductive repetitionLimit : Nat → Prop where
  /-- `(repetition_limit 2)` -/
  | c1 : repetitionLimit 2

/-- GDL `draw_by_repetition`. -/
inductive drawByRepetition (p : Chess.Position) (rec : Ideas.Game.Record Chess.Position Chess.RepetitionKey) : Prop where
  /-- `(<= draw_by_repetition (repetition_limit ?n) (record ?n))` -/
  | c1 {n : Nat} : repetitionLimit n → Ideas.Spec.Binding.seen rec p = n → drawByRepetition p rec

/-- GDL `stalemate`. -/
inductive stalemate (p : Chess.Position) : Prop where
  /-- `(<= stalemate (true (control ?c)) (not (check ?c)) (not has_move))` -/
  | c1 {c : Chess.Color} : p.turn = c → ¬ (check p c) → ¬ (hasMove p) → stalemate p

/-- GDL `drawn`. -/
inductive drawn (p : Chess.Position) (rec : Ideas.Game.Record Chess.Position Chess.RepetitionKey) : Prop where
  /-- `(<= drawn stalemate)` -/
  | c1 : stalemate p → drawn p rec
  /-- `(<= drawn draw)` -/
  | c2 : draw p → drawn p rec
  /-- `(<= drawn draw_by_fifty_moves)` -/
  | c3 : drawByFiftyMoves p → drawn p rec
  /-- `(<= drawn draw_by_repetition)` -/
  | c4 : drawByRepetition p rec → drawn p rec

/-- GDL `mate`. -/
inductive mate (p : Chess.Position) : Prop where
  /-- `(<= mate (check ?c) (not has_move))` -/
  | c1 {c : Chess.Color} : check p c → ¬ (hasMove p) → mate p

/-- GDL `goal`. -/
inductive goal (p : Chess.Position) (rec : Ideas.Game.Record Chess.Position Chess.RepetitionKey) : Chess.Color → Nat → Prop where
  /-- `(<= (goal ?c 0) mate (true (control ?c)))` -/
  | c1 {c : Chess.Color} : mate p → p.turn = c → goal p rec c 0
  /-- `(<= (goal ?o 100) mate (true (control ?c)) (opponent ?c ?o))` -/
  | c2 {o : Chess.Color} {c : Chess.Color} : mate p → p.turn = c → opponent c o → goal p rec o 100
  /-- `(<= (goal ?r 50) (role ?r) drawn (not mate))` -/
  | c3 {r : Chess.Color} : role r → drawn p rec → ¬ (mate p) → goal p rec r 50

