  /-- `(<= (selfmate_material ?c) (true (cell ?f ?r ?c ?k)) (distinct ?k king) (distinct ?k queen))` -/
  | c1 {c : Chess.Color} {f : Fin 8} {r : Fin 8} {k : Chess.PieceKind} : p.board (f, r) = some ⟨c, k⟩ → k ≠ Chess.PieceKind.king → k ≠ Chess.PieceKind.queen → selfmateMaterial p c

/-- GDL `light`. -/
inductive light : Fin 8 → Fin 8 → Prop where
  /-- `(<= (light ?f ?r) (file_parity ?f ?p) (rank_parity ?r ?q) (distinct ?p ?q))` -/
  | c1 {f : Fin 8} {r : Fin 8} {p' : Parity} {q' : Parity} : fileParity f p' → rankParity r q' → p' ≠ q' → light f r

/-- GDL `mixed_bishops`. -/
inductive mixedBishops (p : Chess.Position) : Prop where
  /-- `(<= mixed_bishops (true (cell ?f1 ?r1 ?c1 bishop)) (dark ?f1 ?r1) (true (cell ?f2 ?r2 ?c2 bishop)) (light ?f2 ?r2))` -/
  | c1 {f1 : Fin 8} {r1 : Fin 8} {c1 : Chess.Color} {f2 : Fin 8} {r2 : Fin 8} {c2 : Chess.Color} : p.board (f1, r1) = some ⟨c1, Chess.PieceKind.bishop⟩ → dark f1 r1 → p.board (f2, r2) = some ⟨c2, Chess.PieceKind.bishop⟩ → light f2 r2 → mixedBishops p

/-- GDL `insufficient`. -/
inductive insufficient (p : Chess.Position) : Chess.Color → Prop where
  /-- `(<= (insufficient ?c) (role ?c) (not (mating_material ?c)) (has_kind ?c knight) (not (two_units ?c)) (opponent ?c ?o) (not (selfmate_material ?o)))` -/
  | c1 {c : Chess.Color} {o : Chess.Color} : role c → ¬ (matingMaterial p c) → hasKind p c Chess.PieceKind.knight → ¬ (twoUnits p c) → opponent c o → ¬ (selfmateMaterial p o) → insufficient p c
  /-- `(<= (insufficient ?c) (role ?c) (not (mating_material ?c)) (not (has_kind ?c knight)) (has_kind ?c bishop) (not mixed_bishops) (not any_pawn) (not any_knight))` -/
  | c2 {c : Chess.Color} : role c → ¬ (matingMaterial p c) → ¬ (hasKind p c Chess.PieceKind.knight) → hasKind p c Chess.PieceKind.bishop → ¬ (mixedBishops p) → ¬ (anyPawn p) → ¬ (anyKnight p) → insufficient p c
  /-- `(<= (insufficient ?c) (role ?c) (not (mating_material ?c)) (not (has_kind ?c knight)) (not (has_kind ?c bishop)))` -/
  | c3 {c : Chess.Color} : role c → ¬ (matingMaterial p c) → ¬ (hasKind p c Chess.PieceKind.knight) → ¬ (hasKind p c Chess.PieceKind.bishop) → insufficient p c

/-- GDL `draw`. -/
inductive draw (p : Chess.Position) : Prop where
  /-- `(<= draw (insufficient white) (insufficient black))` -/
  | c1 : insufficient p Chess.Color.white → insufficient p Chess.Color.black → draw p

/-- GDL `last_rank`. -/
inductive lastRank : Chess.Color → Fin 8 → Prop where
  /-- `(last_rank white 8)` -/
