# catspace engine server -- CPU by default; build with --build-arg TORCH=cu121 for GPU nodes
FROM python:3.12-slim
ARG TORCH=cpu
RUN apt-get update && apt-get install -y --no-install-recommends git curl stockfish \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY pyproject.toml ./
COPY catspace ./catspace
RUN pip install --no-cache-dir torch --index-url https://download.pytorch.org/whl/${TORCH} \
    && pip install --no-cache-dir -e . python-chess vector-quantize-pytorch numpy \
    && pip install --no-cache-dir awscli
COPY infra/entrypoint_serve.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh
# MODEL_URI: s3://<bucket>/models/<channel>/  (champion.pt + sidecars)  CHANNEL: dev|prod
ENV PORT=8420 DEVICE=auto CHANNEL=dev
EXPOSE 8420
ENTRYPOINT ["/entrypoint.sh"]
