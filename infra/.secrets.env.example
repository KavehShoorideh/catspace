# copy to infra/.secrets.env (gitignored) and fill in
REGISTRY=ghcr.io/YOURUSER                 # any docker registry
MODEL_URI=s3://catspace-models/models     # S3-compatible: AWS S3 / R2 / GCS-interop / MinIO
DATA_URI=s3://catspace-models/data
S3_ENDPOINT=                              # empty for AWS; https://...r2.cloudflarestorage.com for R2
AWS_ACCESS_KEY_ID=...
AWS_SECRET_ACCESS_KEY=...
