.venv/
__pycache__/
*.pyc
*.egg-info/
build/
dist/

# Generated data, wherever it lives. Post-2026-08-03 restructure, data sits in a
# data/ subfolder next to the method that generated it, so these are pattern-
# matched rather than anchored to one /data tree. Keep directory entries and .dvc
# pointers so tree shape and DVC provenance stay in git.
**/data/**
!**/data/
!**/data/**/
!**/data/**/*.dvc
!**/data/**/.gitignore
# catspace/data/ is a python package (code), not a data directory
!catspace/data/
!catspace/data/**
*.npy
*.pkl
*.npz

# regenerated viz output; artifacts/ (curated historical results) stays committed
artifacts/generated/
**/artifacts/generated/
**/logs/
code/out/

.DS_Store
.pytest_cache/
.mypy_cache/
artifacts/experiments/rollout_dump_*.jsonl
# session build outputs & local tracking stores (2026-07-23)
mlflow.db
mlruns/
**/vendor/node_modules/
**/vendor/package*.json
artifacts/viz_options_hub.html

# third-party assets: downloaded, never generated here (maia2.from_pretrained
# gdown-downloads into paths.maia2_models_dir()) -- 267MB, over GitHub's limit
assets/models/
assets/tablebases/
assets/engines/
assets/corpora/
!assets/**/*.dvc
*.pt
