;;; rules/variants/horde.gdl -- HORDE (plan 79.35): chess (rules/chess.gdl) with another START and other COUNTS. One side (white) has no king and a horde of 36 pawns (a pawn on every square of the first four ranks and on b5 c5 f5 g5); the
;;; other (black) has the usual army. A pawn on the FIRST rank may step two squares as well as one (the passed-over square is set only by a step from the second rank, as in chess). The side that has no unit left LOSES at once. Black's king
;;; can never be mated out of existence, so no side's material is ever insufficient (the library's rule: the side with the king always can win by capturing the horde): the draw by dead material is taken away. A DELTA on the base
;;; (cs_gdl::compose): (retract <clause>) removes a clause of the base, every other form is added. Certified against the kernel by co-play (discovery/certify.py).
(retract (<= draw (insufficient white) (insufficient black)))
(retract (<= (goal ?r 50) (role ?r) drawn (not mate)))
;;; the start: white's army taken away and the horde given; white keeps no right to castle
(retract (init (cell a 1 white rook)))
(retract (init (cell b 1 white knight)))
(retract (init (cell c 1 white bishop)))
(retract (init (cell d 1 white queen)))
(retract (init (cell e 1 white king)))
(retract (init (cell f 1 white bishop)))
(retract (init (cell g 1 white knight)))
(retract (init (cell h 1 white rook)))
(retract (init (cell a 2 white pawn)))
(retract (init (cell b 2 white pawn)))
(retract (init (cell c 2 white pawn)))
(retract (init (cell d 2 white pawn)))
(retract (init (cell e 2 white pawn)))
(retract (init (cell f 2 white pawn)))
(retract (init (cell g 2 white pawn)))
(retract (init (cell h 2 white pawn)))
(retract (init (castling_right white kingside)))
(retract (init (castling_right white queenside)))
(init (cell a 1 white pawn)) (init (cell b 1 white pawn)) (init (cell c 1 white pawn)) (init (cell d 1 white pawn)) (init (cell e 1 white pawn)) (init (cell f 1 white pawn)) (init (cell g 1 white pawn)) (init (cell h 1 white pawn))
(init (cell a 2 white pawn)) (init (cell b 2 white pawn)) (init (cell c 2 white pawn)) (init (cell d 2 white pawn)) (init (cell e 2 white pawn)) (init (cell f 2 white pawn)) (init (cell g 2 white pawn)) (init (cell h 2 white pawn))
(init (cell a 3 white pawn)) (init (cell b 3 white pawn)) (init (cell c 3 white pawn)) (init (cell d 3 white pawn)) (init (cell e 3 white pawn)) (init (cell f 3 white pawn)) (init (cell g 3 white pawn)) (init (cell h 3 white pawn))
(init (cell a 4 white pawn)) (init (cell b 4 white pawn)) (init (cell c 4 white pawn)) (init (cell d 4 white pawn)) (init (cell e 4 white pawn)) (init (cell f 4 white pawn)) (init (cell g 4 white pawn)) (init (cell h 4 white pawn))
(init (cell b 5 white pawn)) (init (cell c 5 white pawn)) (init (cell f 5 white pawn)) (init (cell g 5 white pawn))
;;; the first rank: a unit of the smallest kind there may also step two (the base's two-step reads its start rank from `pawn_start`, which is also what sets the passed-over square, so a second table is added)
(signature first_rank side rank) (signature any_unit side) (signature empty_side side) (signature emptied)
(first_rank white 1)
(<= (move_by pawn ?c ?f ?r1 ?f ?r3) (true (control ?c)) (true (cell ?f ?r1 ?c pawn)) (first_rank ?c ?r1) (forward ?c ?d)
    (step ?d ?f ?r1 ?f ?r2) (empty ?f ?r2) (step ?d ?f ?r2 ?f ?r3) (empty ?f ?r3))
;;; the end: the side with no unit left has lost (a side with units but no move is stalemated as in chess)
(<= (any_unit ?c) (true (cell ?f ?r ?c ?k)))
(<= (empty_side ?c) (role ?c) (not (any_unit ?c)))
(<= emptied (empty_side ?c))
(<= terminal emptied)
(<= (goal ?c 0) (empty_side ?c))
(<= (goal ?o 100) (empty_side ?c) (opponent ?c ?o))
(<= (goal ?r 50) (role ?r) drawn (not mate) (not emptied))
