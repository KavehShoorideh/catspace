;;; rules/variants/atomic.gdl -- ATOMIC (plan 79.35): chess (rules/chess.gdl) with OTHER RULES OF MOVING AND ENDING. The start is the standard one. A TAKING IS AN EXPLOSION: the unit that takes is removed with the unit it takes, and so is every unit of
;;; the eight places around the place taken that is not of the smallest kind (the pawns around stay; a pawn taken in passing explodes the place it passed over). The KING DOES NOT TAKE. A move that would remove the mover's own king is not allowed;
;;; a king removed ends the game at once for its side (a king may be removed by any taking beside it). The two kings side by side: a king next to the other king is not struck, and the places beside a king are not struck by the other side
;;; (which is what makes a taking beside the other king possible). The draw by dead material is the library's rule for this game. A DELTA on the base (cs_gdl::compose): (retract <clause>) removes a clause of the base, every other form is added.
;;; Certified against the kernel by co-play (discovery/certify.py).
(signature ak side) (signature nonking side) (signature kings_touch) (signature touches_king side file rank) (signature struck side file rank)
(signature taking file rank file rank) (signature blasted file rank file rank file rank) (signature king_lost file rank file rank) (signature enemy_king_gone file rank file rank)
(signature touch_after file rank file rank) (signature exposed_atomic file rank file rank) (signature sound file rank file rank) (signature taking_now file rank) (signature blasted_now file rank)
(signature king_gone side) (signature exploded) (signature non_knight_unit) (signature queen_or_pawn) (signature one_nonking) (signature two_nonking) (signature three_nonking) (signature diff_sq file rank file rank)
(signature wd_bishop) (signature wl_bishop) (signature bl_bishop) (signature bd_bishop) (signature bishop_dead) (signature only_kings_bishops) (signature other_than_bishop) (signature dead side)
(<= (ak ?c) (true (cell ?f ?r ?c king)))
(<= (nonking ?c) (true (cell ?f ?r ?c ?k)) (distinct ?k king))
;;; the kings side by side; a place beside the king of a side is not struck by that side's units
(<= kings_touch (true (cell ?f1 ?r1 white king)) (true (cell ?f2 ?r2 black king)) (king_step ?f1 ?r1 ?f2 ?r2))
(<= (touches_king ?o ?f ?r) (true (cell ?f2 ?r2 ?o king)) (king_step ?f ?r ?f2 ?r2))
(<= (struck ?o ?f ?r) (attacked ?o ?f ?r) (not (touches_king ?o ?f ?r)))
(retract (<= (check ?c) (true (control ?c)) (true (cell ?f ?r ?c king)) (opponent ?c ?o) (attacked ?o ?f ?r)))
(<= (check ?c) (true (control ?c)) (true (cell ?f ?r ?c king)) (opponent ?c ?o) (struck ?o ?f ?r))
(retract (<= (castle_unsafe ?c ?side) (home_rank ?c ?r) (castling_safe ?side ?f) (opponent ?c ?o) (attacked ?o ?f ?r)))
(<= (castle_unsafe ?c ?side) (home_rank ?c ?r) (castling_safe ?side ?f) (opponent ?c ?o) (struck ?o ?f ?r))
;;; what may be taken: any unit of the other side, the king too (by a unit that is not a king); the king takes nothing
(retract (<= (may_land ?c ?f ?r) (true (cell ?f ?r ?o ?j)) (opponent ?c ?o) (distinct ?j king)))
(<= (may_land ?c ?f ?r) (true (cell ?f ?r ?o ?j)) (opponent ?c ?o))
(retract (<= (move_by ?k ?c ?f1 ?r1 ?f2 ?r2) (true (control ?c)) (attack_by ?k ?c ?f1 ?r1 ?f2 ?r2) (distinct ?k pawn) (may_land ?c ?f2 ?r2)))
(<= (move_by ?k ?c ?f1 ?r1 ?f2 ?r2) (true (control ?c)) (attack_by ?k ?c ?f1 ?r1 ?f2 ?r2) (distinct ?k pawn) (distinct ?k king) (may_land ?c ?f2 ?r2))
(<= (move_by king ?c ?f1 ?r1 ?f2 ?r2) (true (control ?c)) (attack_by king ?c ?f1 ?r1 ?f2 ?r2) (empty ?f2 ?r2))
(retract (<= (move_by pawn ?c ?f1 ?r1 ?f2 ?r2) (true (control ?c)) (attack_by pawn ?c ?f1 ?r1 ?f2 ?r2) (true (cell ?f2 ?r2 ?o ?j)) (opponent ?c ?o) (distinct ?j king)))
(<= (move_by pawn ?c ?f1 ?r1 ?f2 ?r2) (true (control ?c)) (attack_by pawn ?c ?f1 ?r1 ?f2 ?r2) (true (cell ?f2 ?r2 ?o ?j)) (opponent ?c ?o))
;;; THE EXPLOSION of a candidate that takes (a taking in passing included): the unit taken and every unit that is not of the smallest kind within a step of the place taken (the place a pawn passed over, for a taking in passing)
(<= (taking ?f1 ?r1 ?f2 ?r2) (capture ?k ?c ?f1 ?r1 ?f2 ?r2))
(<= (blasted ?f1 ?r1 ?f2 ?r2 ?f2 ?r2) (taking ?f1 ?r1 ?f2 ?r2) (occupied ?f2 ?r2))
(<= (blasted ?f1 ?r1 ?f2 ?r2 ?f ?r) (taking ?f1 ?r1 ?f2 ?r2) (true (cell ?f ?r ?c ?k)) (distinct ?k pawn) (king_step ?f2 ?r2 ?f ?r))
;;; the board after a candidate: what the explosion removes is emptied, and the unit that took does not land
(<= (vacates ?f1 ?r1 ?f2 ?r2 ?f ?r) (blasted ?f1 ?r1 ?f2 ?r2 ?f ?r))
(retract (<= (fills ?f1 ?r1 ?f2 ?r2 ?f2 ?r2 ?c ?k) (candidate ?c ?f1 ?r1 ?f2 ?r2) (true (cell ?f1 ?r1 ?c ?k))))
(<= (fills ?f1 ?r1 ?f2 ?r2 ?f2 ?r2 ?c ?k) (candidate ?c ?f1 ?r1 ?f2 ?r2) (true (cell ?f1 ?r1 ?c ?k)) (not (taking ?f1 ?r1 ?f2 ?r2)))
;;; a move is allowed when the mover's king is not removed and either the other king is removed or the mover's king is not struck after it (two kings side by side strike nothing)
(<= (king_lost ?f1 ?r1 ?f2 ?r2) (candidate ?c ?f1 ?r1 ?f2 ?r2) (true (cell ?f ?r ?c king)) (blasted ?f1 ?r1 ?f2 ?r2 ?f ?r))
(<= (enemy_king_gone ?f1 ?r1 ?f2 ?r2) (candidate ?c ?f1 ?r1 ?f2 ?r2) (opponent ?c ?o) (true (cell ?f ?r ?o king)) (blasted ?f1 ?r1 ?f2 ?r2 ?f ?r))
(<= (touch_after ?f1 ?r1 ?f2 ?r2) (king_after ?c ?f1 ?r1 ?f2 ?r2 ?kf ?kr) (opponent ?c ?o) (after ?f1 ?r1 ?f2 ?r2 ?f ?r ?o king) (king_step ?kf ?kr ?f ?r))
(<= (exposed_atomic ?f1 ?r1 ?f2 ?r2) (exposed ?f1 ?r1 ?f2 ?r2) (not (touch_after ?f1 ?r1 ?f2 ?r2)))
(<= (sound ?f1 ?r1 ?f2 ?r2) (candidate ?c ?f1 ?r1 ?f2 ?r2) (not (king_lost ?f1 ?r1 ?f2 ?r2)) (enemy_king_gone ?f1 ?r1 ?f2 ?r2))
(<= (sound ?f1 ?r1 ?f2 ?r2) (candidate ?c ?f1 ?r1 ?f2 ?r2) (not (king_lost ?f1 ?r1 ?f2 ?r2)) (not (exposed_atomic ?f1 ?r1 ?f2 ?r2)))
(retract (<= (legal ?c (move ?f1 ?r1 ?f2 ?r2)) (candidate ?c ?f1 ?r1 ?f2 ?r2) (not (promotes ?c ?f1 ?r1 ?f2 ?r2)) (not (exposed ?f1 ?r1 ?f2 ?r2))))
(retract (<= (legal ?c (promote ?f1 ?r1 ?f2 ?r2 ?k)) (promotes ?c ?f1 ?r1 ?f2 ?r2) (not (exposed ?f1 ?r1 ?f2 ?r2)) (promotable ?k)))
(<= (legal ?c (move ?f1 ?r1 ?f2 ?r2)) (candidate ?c ?f1 ?r1 ?f2 ?r2) (not (promotes ?c ?f1 ?r1 ?f2 ?r2)) (sound ?f1 ?r1 ?f2 ?r2))
(<= (legal ?c (promote ?f1 ?r1 ?f2 ?r2 ?k)) (promotes ?c ?f1 ?r1 ?f2 ?r2) (sound ?f1 ?r1 ?f2 ?r2) (promotable ?k))
;;; the next state: a taking removes the taker and what the explosion takes (the rights that stood on a removed unit's place end with it)
(<= (taking_now ?f2 ?r2) (does ?c (move ?f1 ?r1 ?f2 ?r2)) (taking ?f1 ?r1 ?f2 ?r2))
(<= (taking_now ?f2 ?r2) (does ?c (promote ?f1 ?r1 ?f2 ?r2 ?k)) (taking ?f1 ?r1 ?f2 ?r2))
(<= (blasted_now ?f ?r) (does ?c (move ?f1 ?r1 ?f2 ?r2)) (blasted ?f1 ?r1 ?f2 ?r2 ?f ?r))
(<= (blasted_now ?f ?r) (does ?c (promote ?f1 ?r1 ?f2 ?r2 ?k)) (blasted ?f1 ?r1 ?f2 ?r2 ?f ?r))
(<= (lifted ?f ?r) (blasted_now ?f ?r))
(retract (<= (next (cell ?f2 ?r2 ?c ?k)) (does ?c (move ?f1 ?r1 ?f2 ?r2)) (true (cell ?f1 ?r1 ?c ?k))))
(<= (next (cell ?f2 ?r2 ?c ?k)) (does ?c (move ?f1 ?r1 ?f2 ?r2)) (true (cell ?f1 ?r1 ?c ?k)) (not (taking_now ?f2 ?r2)))
(retract (<= (next (cell ?f2 ?r2 ?c ?k)) (does ?c (promote ?f1 ?r1 ?f2 ?r2 ?k))))
(<= (next (cell ?f2 ?r2 ?c ?k)) (does ?c (promote ?f1 ?r1 ?f2 ?r2 ?k)) (not (taking_now ?f2 ?r2)))
;;; the ends: a king removed ends the game for its side; no move left is a stalemate or a mate as in chess (a king beside the other is not in check)
(<= (king_gone ?c) (role ?c) (not (ak ?c)))
(<= exploded (king_gone ?c))
(<= terminal exploded)
(<= (goal ?c 0) (king_gone ?c))
(<= (goal ?o 100) (king_gone ?c) (opponent ?c ?o))
(retract (<= (goal ?r 50) (role ?r) drawn (not mate)))
(<= (goal ?r 50) (role ?r) drawn (not mate) (not exploded))
;;; the draw by dead material, as the library reads it for this game (a side is short of material when it cannot remove the other side's king by any series of takings that the material allows)
(retract (<= draw (insufficient white) (insufficient black)))
(<= (diff_sq ?f1 ?r1 ?f2 ?r2) (square ?f1 ?r1) (square ?f2 ?r2) (distinct ?f1 ?f2))
(<= (diff_sq ?f1 ?r1 ?f2 ?r2) (square ?f1 ?r1) (square ?f2 ?r2) (distinct ?r1 ?r2))
(<= queen_or_pawn (true (cell ?f ?r ?c queen)))
(<= queen_or_pawn (true (cell ?f ?r ?c pawn)))
(<= non_knight_unit (true (cell ?f ?r ?c ?k)) (distinct ?k king) (distinct ?k knight))
(<= one_nonking (nonking ?c) (not two_nonking))
(<= two_nonking (true (cell ?f1 ?r1 ?c1 ?k1)) (distinct ?k1 king) (true (cell ?f2 ?r2 ?c2 ?k2)) (distinct ?k2 king) (diff_sq ?f1 ?r1 ?f2 ?r2))
(<= three_nonking (true (cell ?f1 ?r1 ?c1 ?k1)) (distinct ?k1 king) (true (cell ?f2 ?r2 ?c2 ?k2)) (distinct ?k2 king) (true (cell ?f3 ?r3 ?c3 ?k3)) (distinct ?k3 king)
    (diff_sq ?f1 ?r1 ?f2 ?r2) (diff_sq ?f1 ?r1 ?f3 ?r3) (diff_sq ?f2 ?r2 ?f3 ?r3))
(<= other_than_bishop (true (cell ?f ?r ?c ?k)) (distinct ?k king) (distinct ?k bishop))
(<= only_kings_bishops (not other_than_bishop))
(<= wd_bishop (true (cell ?f ?r white bishop)) (dark ?f ?r))
(<= wl_bishop (true (cell ?f ?r white bishop)) (light ?f ?r))
(<= bl_bishop (true (cell ?f ?r black bishop)) (light ?f ?r))
(<= bd_bishop (true (cell ?f ?r black bishop)) (dark ?f ?r))
(<= bishop_dead (not wd_bishop) (not bl_bishop))
(<= bishop_dead wd_bishop (not wl_bishop) (not bd_bishop))
;;; the other side's king is not gone; a side with only its king is short; while the other side has more than its king: only kings and bishops on the board decide (as read by the colours of the bishops); with the other side bare: no queen or pawn, and
;;; one unit that is not a king, or two knights alone
(<= (dead ?c) (opponent ?c ?o) (ak ?o) (role ?c) (not (nonking ?c)))
(<= (dead ?c) (opponent ?c ?o) (ak ?o) (nonking ?c) (nonking ?o) only_kings_bishops bishop_dead)
(<= (dead ?c) (opponent ?c ?o) (ak ?o) (nonking ?c) (not (nonking ?o)) (not queen_or_pawn) one_nonking)
(<= (dead ?c) (opponent ?c ?o) (ak ?o) (nonking ?c) (not (nonking ?o)) (not queen_or_pawn) two_nonking (not three_nonking) (not non_knight_unit))
(<= draw (dead white) (dead black))
