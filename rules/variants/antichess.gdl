;;; rules/variants/antichess.gdl -- ANTICHESS (plan 79.35): chess (rules/chess.gdl) with OTHER RULES OF MOVING AND ENDING. The start is the standard one without the right to castle. A TAKING IS COMPULSORY when one is there (some move of the side to
;;; move takes a unit: then only the takings are allowed). The king is an ordinary unit: it takes and is taken, it may stand where it is struck and be left struck (there is no check, no mate), and there is no two-unit move of it. A pawn that
;;; reaches the last rank may become a king as well as a queen, rook, bishop or knight. The side that has NO UNIT left, or NO MOVE left (a stalemate), WINS. The draw by dead material is the library's rule for this game (the bishop case and the case
;;; of one knight each, read from the position and the side to move). A DELTA on the base (cs_gdl::compose): (retract <clause>) removes a clause of the base, every other form is added. Certified against the kernel by co-play (discovery/certify.py).
(retract (init (castling_right white kingside)))
(retract (init (castling_right white queenside)))
(retract (init (castling_right black kingside)))
(retract (init (castling_right black queenside)))
;;; no check: a unit that is struck is not in check (the relation stays, with no clause)
(retract (<= (check ?c) (true (control ?c)) (true (cell ?f ?r ?c king)) (opponent ?c ?o) (attacked ?o ?f ?r)))
;;; the king is taken like any unit
(retract (<= (may_land ?c ?f ?r) (true (cell ?f ?r ?o ?j)) (opponent ?c ?o) (distinct ?j king)))
(<= (may_land ?c ?f ?r) (true (cell ?f ?r ?o ?j)) (opponent ?c ?o))
(retract (<= (move_by pawn ?c ?f1 ?r1 ?f2 ?r2) (true (control ?c)) (attack_by pawn ?c ?f1 ?r1 ?f2 ?r2) (true (cell ?f2 ?r2 ?o ?j)) (opponent ?c ?o) (distinct ?j king)))
(<= (move_by pawn ?c ?f1 ?r1 ?f2 ?r2) (true (control ?c)) (attack_by pawn ?c ?f1 ?r1 ?f2 ?r2) (true (cell ?f2 ?r2 ?o ?j)) (opponent ?c ?o))
;;; the smallest kind may become a king too
(promotable king)
;;; a taking is compulsory: a candidate is allowed when it takes, or when no candidate does
(signature some_taking) (signature allowed side file rank file rank)
(<= some_taking (capture ?k ?c ?f1 ?r1 ?f2 ?r2))
(<= (allowed ?c ?f1 ?r1 ?f2 ?r2) (candidate ?c ?f1 ?r1 ?f2 ?r2) (capture ?k ?c ?f1 ?r1 ?f2 ?r2))
(<= (allowed ?c ?f1 ?r1 ?f2 ?r2) (candidate ?c ?f1 ?r1 ?f2 ?r2) (not some_taking))
(retract (<= (legal ?c (move ?f1 ?r1 ?f2 ?r2)) (candidate ?c ?f1 ?r1 ?f2 ?r2) (not (promotes ?c ?f1 ?r1 ?f2 ?r2)) (not (exposed ?f1 ?r1 ?f2 ?r2))))
(retract (<= (legal ?c (promote ?f1 ?r1 ?f2 ?r2 ?k)) (promotes ?c ?f1 ?r1 ?f2 ?r2) (not (exposed ?f1 ?r1 ?f2 ?r2)) (promotable ?k)))
(<= (legal ?c (move ?f1 ?r1 ?f2 ?r2)) (candidate ?c ?f1 ?r1 ?f2 ?r2) (not (promotes ?c ?f1 ?r1 ?f2 ?r2)) (allowed ?c ?f1 ?r1 ?f2 ?r2))
(<= (legal ?c (promote ?f1 ?r1 ?f2 ?r2 ?k)) (promotes ?c ?f1 ?r1 ?f2 ?r2) (allowed ?c ?f1 ?r1 ?f2 ?r2) (promotable ?k))
;;; the ends: the side to move that has no move left (a side with no unit has none) wins; dead material draws, as the library reads it, unless the side to move has won
(retract (<= drawn stalemate))
(retract (<= (goal ?r 50) (role ?r) drawn (not mate)))
(<= (goal ?c 100) stalemate (true (control ?c)))
(<= (goal ?o 0) stalemate (true (control ?c)) (opponent ?c ?o))
(<= (goal ?r 50) (role ?r) drawn (not stalemate))
(retract (<= draw (insufficient white) (insufficient black)))
(signature a_unit side) (signature non_bishop) (signature non_knight) (signature some_light side) (signature some_dark side) (signature two_or_more side)
(signature knight_light) (signature knight_dark) (signature knights_alone) (signature odd_parity) (signature dead side)
(<= (a_unit ?c) (true (cell ?f ?r ?c ?k)))
(<= non_bishop (true (cell ?f ?r ?c ?k)) (distinct ?k bishop))
(<= non_knight (true (cell ?f ?r ?c ?k)) (distinct ?k knight))
(<= (some_light ?c) (true (cell ?f ?r ?c ?k)) (light ?f ?r))
(<= (some_dark ?c) (true (cell ?f ?r ?c ?k)) (dark ?f ?r))
(<= (two_or_more ?c) (true (cell ?f1 ?r1 ?c ?k1)) (true (cell ?f2 ?r2 ?c ?k2)) (distinct ?f1 ?f2))
(<= (two_or_more ?c) (true (cell ?f1 ?r1 ?c ?k1)) (true (cell ?f2 ?r2 ?c ?k2)) (distinct ?r1 ?r2))
(<= knight_light (true (cell ?f ?r white knight)) (light ?f ?r))
(<= knight_dark (true (cell ?f ?r black knight)) (dark ?f ?r))
(<= knights_alone (not non_knight) (a_unit white) (a_unit black) (not (two_or_more white)) (not (two_or_more black)))
(<= odd_parity knight_light (not knight_dark))
(<= odd_parity (not knight_light) knight_dark)
;;; a side with no unit is not short of material; a side against nothing is; two sides of bishops alone: one of ours on a colour the other side has none of; one knight each: by the side to move and the colours the knights stand on
(<= (dead ?c) (a_unit ?c) (opponent ?c ?o) (not (a_unit ?o)))
(<= (dead ?c) (a_unit ?c) (opponent ?c ?o) (a_unit ?o) (not non_bishop) (some_light ?c) (not (some_light ?o)))
(<= (dead ?c) (a_unit ?c) (opponent ?c ?o) (a_unit ?o) (not non_bishop) (some_dark ?c) (not (some_dark ?o)))
(<= (dead ?c) knights_alone (true (control ?c)) (not odd_parity))
(<= (dead ?c) knights_alone (true (control ?o)) (opponent ?c ?o) odd_parity)
(<= draw (dead white) (dead black))
